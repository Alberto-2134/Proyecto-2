<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcosistemaAcademico</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcosistemaAcademico.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
</head>
<body class="tema">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">EcosistemaAcademico</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
    </li>

    @if (User.IsInRole("Administrador"))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">Usuarios</a>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Estudiantes" asp-action="Index">Estudiantes</a></li>
                <li><a class="dropdown-item" asp-controller="Tutores" asp-action="Index">Tutores</a></li>
                <li><a class="dropdown-item" asp-controller="Administradores" asp-action="Index">Administradores</a></li>
            </ul>
        </li>
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">Académico</a>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Asignaturas" asp-action="Index">Asignaturas</a></li>
                <li><a class="dropdown-item" asp-controller="TutorAsignaturas" asp-action="Index">Tutor-Asignatura</a></li>
                <li><a class="dropdown-item" asp-controller="Diagnosticos" asp-action="Index">Diagnósticos</a></li>
            </ul>
        </li>
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">Gestión</a>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Emparejamientos" asp-action="Index">Emparejamientos</a></li>
                <li><a class="dropdown-item" asp-controller="Seguimientos" asp-action="Index">Seguimientos</a></li>
            </ul>
        </li>
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">Biblioteca</a>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Recursos" asp-action="Index">Recursos</a></li>
                <li><a class="dropdown-item" asp-controller="Repositorios" asp-action="Index">Repositorios</a></li>
            </ul>
        </li>
    }
</ul>
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <span class="nav-link text-dark">
                                    @User.Identity?.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">Cerrar sesión</a>
                            </li>
                        </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EcosistemaAcademico - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
