model List<EcosistemaAcademico.Models.Entidades.Emparejamiento>
@{ ViewData["Title"] = "Emparejamientos"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3> Emparejamientos </h3>
<div>
    <button class="btn btn-success me-2" onclick="abrirAuto()">Emparejar automáticamente</button>
    <button class="btn btn-primary" onclick="abrirForm()">+ Nuevo emparejamiento</button>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-hover align-middle">
    <thead class="table-light">
      <tr><th>Fecha</th><th>Estudiante</th><th>Tutor</th><th>Asignatura</th><th>Afinidad</th><th>Estado</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td>@a.Fecha.ToString("dd/MM/yyyy")</td>
            <td>@a.Estudiante?.Nombre @a.Estudiante?.Apellido</td>
            <td>@a.Tutor?.Nombre @a.Tutor?.Apellido</td>
            <td>@a.Asignatura?.Nombre</td>
            <td>@a.PuntajeAfinidad.ToString("0.0")%</td>
            <td>
                <span class="badge @(a.Estado == "Activo" ? "bg-success" : a.Estado == "Pendiente" ? "bg-warning text-dark" : "bg-secondary")">@a.Estado</span>
            </td>
            <td class="text-end">
                <button class="btn btn-sm btn-outline-primary" onclick="abrirForm(@a.Id)">Editar</button>
                <button class="btn btn-sm btn-outline-danger" onclick="abrirEliminar(@a.Id,'@a.Estudiante?.Nombre')">Eliminar</button>
            </td>
        </tr>
    }
    </tbody>
</table>

<!-- Modal crear/editar -->
<div class="modal fade" id="modalForm" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Asignatura</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody"></div>
        </div>
    </div>
</div>

<!-- Modal eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Eliminar" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="idEliminar" />
                    ¿Eliminar el emparejamiento <strong id="nombreEliminar"></strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Modal emparejar automáticamente -->
<div class="modal fade" id="modalAuto" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Emparejar automáticamente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formAuto" asp-action="Asignar" method="post">
                    <input type="hidden" name="tutorId" id="autoTutor" />
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Estudiante</label>
                            <select name="estudianteId" id="autoEstudiante" asp-items="ViewBag.Estudiantes" class="form-select">
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Asignatura</label>
                            <select name="asignaturaId" id="autoAsignatura" asp-items="ViewBag.Asignaturas" class="form-select">
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-primary" onclick="buscarTutores()">Buscar mejores tutores</button>
                </form>
                <div id="resultadoAuto" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function abrirForm(id) {
        const r = await fetch('/Emparejamientos/Formulario/' + (id ?? ''));
        document.getElementById('modalBody').innerHTML = await r.text();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalForm')).show();
    }

    function abrirEliminar(id, nombre) {
        document.getElementById('idEliminar').value = id;
        document.getElementById('nombreEliminar').textContent = nombre;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalEliminar')).show();
    }
    function abrirAuto() {
    document.getElementById('resultadoAuto').innerHTML = '';
    bootstrap.Modal.getOrCreateInstance(document.getElementById('modalAuto')).show();
}

async function buscarTutores() {
    const est = document.getElementById('autoEstudiante').value;
    const asi = document.getElementById('autoAsignatura').value;
    const cont = document.getElementById('resultadoAuto');
    if (!est || !asi) {
        cont.innerHTML = '<div class="alert alert-warning">Selecciona un estudiante y una asignatura</div>';
        return;
    }
    const r = await fetch('/Emparejamientos/Sugerencias?estudianteId=' + est + '&asignaturaId=' + asi);
    cont.innerHTML = await r.text();
}

function asignarTutor(tutorId) {
    document.getElementById('autoTutor').value = tutorId;
    const form = document.getElementById('formAuto');
    fetch(form.action, { method: 'POST', body: new FormData(form) })
        .then(r => { if (r.ok) location.reload(); });
}


    document.addEventListener('submit', async e => {
        if (e.target.id !== 'formEmparejamiento') return;
        e.preventDefault();
        const r = await fetch(e.target.action, { method: 'POST', body: new FormData(e.target) });
        if ((r.headers.get('content-type') || '').includes('json')) location.reload();
        else document.getElementById('modalBody').innerHTML = await r.text(); // muestra errores
    });
</script>
}