model List<EcosistemaAcademico.Models.Entidades.Repositorio>
@{ ViewData["Title"] = "Repositorios"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3> el repositorio </h3>
    <button class="btn btn-primary" onclick="abrirForm()">+ Nuevo repositorio”</button>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-hover align-middle">
    <thead class="table-light">
       <tr><th>Nombre</th><th>Sede</th><th>Ubicación</th><th>Tipo</th><th>Capacidad</th><th>Administrador</th><th>Estado</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td>@a.Nombre</td>
            <td>@a.Sede</td>
            <td>@a.Ubicacion</td>
            <td>@a.Tipo</td>
            <td>@a.CapacidadGB GB</td>
            <td>@a.Administrador?.Nombre @a.Administrador?.Apellido</td>
            <td>@(a.Estado ? "Activo" : "Inactivo")</td>
            <td class="text-end">
                <button class="btn btn-sm btn-outline-primary" onclick="abrirForm(@a.Id)">Editar</button>
                <button class="btn btn-sm btn-outline-danger" onclick="abrirEliminar(@a.Id,'@a.Nombre')">Eliminar</button>
            </td>
        </tr>
    }
    </tbody>
</table>

<!-- Modal crear/editar -->
<div class="modal fade" id="modalForm" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Asignatura</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody"></div>
        </div>
    </div>
</div>

<!-- Modal eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Eliminar" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="idEliminar" />
                    ¿Eliminar el repositorio <strong id="nombreEliminar"></strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function abrirForm(id) {
        const r = await fetch('/Repositorios/Formulario/' + (id ?? ''));
        document.getElementById('modalBody').innerHTML = await r.text();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalForm')).show();
    }

    function abrirEliminar(id, nombre) {
        document.getElementById('idEliminar').value = id;
        document.getElementById('nombreEliminar').textContent = nombre;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalEliminar')).show();
    }

    document.addEventListener('submit', async e => {
        if (e.target.id !== 'formRepositorio') return;
        e.preventDefault();
        const r = await fetch(e.target.action, { method: 'POST', body: new FormData(e.target) });
        if ((r.headers.get('content-type') || '').includes('json')) location.reload();
        else document.getElementById('modalBody').innerHTML = await r.text(); // muestra errores
    });
</script>
}